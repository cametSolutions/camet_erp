# Backend only - do not add either value to frontend/.env or a VITE_ variable.
# Convert the QZ files to one-line base64 before pasting them into your backend host.
QZ_CERTIFICATE_BASE64=
QZ_PRIVATE_KEY_BASE64=

# Frontend only - safe because it contains no secret.
# Set this in frontend/.env.production, then rebuild the frontend.
VITE_QZ_SIGNING_ENABLED=true
